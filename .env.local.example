# ── Supabase ──────────────────────────────────────────────────────
# Used by My Basket, Basket Editor, Video Studio, and Dynamic Content
# to stash record IDs from Aprimo multi-record page-hook actions.
# Schema: supabase/create_requested_records.sql
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# ── Webhook ────────────────────────────────────────────────────────
# Must match the secret configured in Aprimo's page hook settings.
WEBHOOK_SECRET="your-webhook-secret"

# ── Aprimo PKCE OAuth ─────────────────────────────────────────────
# Optional — if all three are set, the app auto-connects on every page.
# Otherwise the user enters them via the in-app Connect dialog.
NEXT_PUBLIC_APRIMO_ENVIRONMENT="your-environment"
NEXT_PUBLIC_APRIMO_CLIENT_ID="your-client-id"
NEXT_PUBLIC_APRIMO_CLIENT_SECRET="your-client-secret"

# ── Creative Template ─────────────────────────────────────────────
# Required for the Creative Template Create and Fill pages.
# CONTENT_TYPE: content type name or ID for canvas template records.
# JSON_FIELD: internal field name used to store the canvas layout JSON.
# CLASSIFICATION_ID: applied to new template records and filled output assets.
NEXT_PUBLIC_CANVAS_TEMPLATE_CONTENT_TYPE="your-content-type-name-or-id"  # e.g. "CreativeTemplate"
NEXT_PUBLIC_CANVAS_TEMPLATE_JSON_FIELD="your-json-field-name"            # e.g. "_JSONSettings"
NEXT_PUBLIC_CANVAS_TEMPLATE_CLASSIFICATION_ID="your-classification-id"

# ── Video Studio — Save as Asset ──────────────────────────────────
# Required only for Video Studio's "Save as Asset" feature.
NEXT_PUBLIC_VIDEO_STUDIO_CONTENT_TYPE="your-content-type-name-or-id"  # e.g. "VideoProject"
NEXT_PUBLIC_VIDEO_STUDIO_CLASSIFICATION_ID="your-classification-id"
NEXT_PUBLIC_VIDEO_STUDIO_JSON_FIELD="your-json-field-name"           # e.g. "_VideoProjectDetails"
# Optional — internal name of a RecordLink field to link source assets.
#NEXT_PUBLIC_ASSOCIATED_ASSETS_RECORD_LINK_FIELD=

# ── ElevenLabs ────────────────────────────────────────────────────
# Required for Translate Video (/translate-video) and Text to Speech (/text-to-speech).
# Get your key at https://elevenlabs.io → Profile → API key.
ELEVENLABS_API_KEY="your-elevenlabs-api-key"
# Optional — voice ID for TTS (defaults to Rachel: 21m00Tcm4TlvDq8ikWAM).
#ELEVENLABS_TTS_VOICE_ID=
# Optional — content type applied to TTS records (e.g. "Audio").
#NEXT_PUBLIC_AUDIO_CONTENT_TYPE=
# Required for new TTS records (when no ?record= is provided).
NEXT_PUBLIC_TTS_CLASSIFICATION_ID="your-classification-id"

# ── Figma OAuth ───────────────────────────────────────────────────
# Required for Figma import in the Creative Template editor.
# Register an app at https://www.figma.com/developers/apps and add:
#   http://localhost:3000/api/figma-import/oauth/callback  (and your deployed origin)
FIGMA_CLIENT_ID="your-figma-client-id"
FIGMA_CLIENT_SECRET="your-figma-client-secret"
NEXT_PUBLIC_FIGMA_ENABLED="true"
# Optional — override the OAuth redirect URI if it can't be derived from the request origin.
#FIGMA_OAUTH_REDIRECT=
# Optional — override the OAuth scope (defaults to file_content:read).
#FIGMA_SCOPE=
