# ── Supabase ──────────────────────────────────────────────────────
# Used by My Basket, Video Studio (multi-record handoff), and Dynamic
# Content (templates) to stash record IDs from Aprimo page-hook actions.
# Schema: supabase/create_requested_records.sql
NEXT_PUBLIC_SUPABASE_URL="YOUR URL HERE"
NEXT_PUBLIC_SUPABASE_ANON_KEY="YOUR KEY HERE"

# Webhook secret — must match the secret configured in Aprimo's page hook settings
WEBHOOK_SECRET="YOUR WEBHOOK SECRET HERE"

# ── Aprimo PKCE OAuth ─────────────────────────────────────────────
# Optional — if all three are set, the app auto-connects on every page.
# Otherwise the user enters them via the in-app Connect dialog.
NEXT_PUBLIC_APRIMO_ENVIRONMENT="YOUR ENV PREFIX HERE"
NEXT_PUBLIC_APRIMO_CLIENT_ID= "YOUR ID HERE"
NEXT_PUBLIC_APRIMO_CLIENT_SECRET= "YOUR SECRET HERE"

# ── Creative Template ─────────────────────────────────────────────
# Required for the Creative Template Create and Fill pages.
# CONTENT_TYPE: content type name or ID for canvas template records.
# JSON_FIELD: long-text field name used to store the canvas layout JSON.
# CLASSIFICATION_ID: applied to new template records and filled output assets.
NEXT_PUBLIC_CANVAS_TEMPLATE_CONTENT_TYPE="YOUR CONTENT TYPE NAME OR ID"
NEXT_PUBLIC_CANVAS_TEMPLATE_JSON_FIELD="YOUR JSON FIELD NAME"
NEXT_PUBLIC_CANVAS_TEMPLATE_CLASSIFICATION_ID="YOUR CLASSIFICATION ID"

# ── Video Studio — Save as Asset ──────────────────────────────────
# Required only for Video Studio's "Save as Asset" feature. Content type,
# classification, and field used to store the project state JSON.
NEXT_PUBLIC_VIDEO_STUDIO_CONTENT_TYPE="YOUR CONTENT TYPE NAME OR ID"
NEXT_PUBLIC_VIDEO_STUDIO_CLASSIFICATION_ID="YOUR CLASSIFICATION ID"
NEXT_PUBLIC_VIDEO_STUDIO_JSON_FIELD="YOUR JSON FIELD NAME"
NEXT_PUBLIC_ASSOCIATED_ASSETS_RECORD_LINK_FIELD="YOUR FIELD NAME HERE"

# Figma OAuth app (used by /figma-import to import designs directly from Figma).
# Register an app at https://www.figma.com/developers/apps and add this redirect URL:
#   http://localhost:3000/api/figma-import/oauth/callback  (and your deployed origin)
FIGMA_CLIENT_ID=
FIGMA_CLIENT_SECRET=
# Optional: override the OAuth redirect URI if it can't be derived from the request origin.
FIGMA_OAUTH_REDIRECT=
# Optional: override the requested OAuth scope. Defaults to file_content:read.
# Must be a scope enabled on your Figma app. See https://developers.figma.com/docs/rest-api/scopes/
FIGMA_SCOPE=

